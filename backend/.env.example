# Cổng khởi chạy Backend API
PORT=5000

# Chuỗi kết nối trực tiếp PostgreSQL / Supabase để chạy Migrations bằng Code
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Cấu hình Supabase API (Dành cho Supabase Client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

