{
  "name": "champa-web-project",
  "version": "1.0.0",
  "description": "Dana Community Tourism - Panduranga Heritage Platform",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    "dev:backend": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:up": "docker compose up -d postgres",
    "db:ps": "docker compose ps postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "npm run migrate --prefix backend",
    "db:rollback": "npm run migrate:rollback --prefix backend",
    "db:status": "npm run migrate:status --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "deploy:cloudrun": "gcloud run deploy champa-web --source . --region asia-southeast1 --allow-unauthenticated"
  },
  "keywords": ["champa", "panduranga", "tourism", "heritage", "react", "express"],
  "author": "Dana Community",
  "license": "ISC"
}
